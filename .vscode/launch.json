    "version": "0.2.0",
    "configurations": [

        {
            "name": "Ritu Art",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "Ritu Art (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "Ritu Art (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "Ritu Art (Flutter Web)",
            "request": "launch",
            "type": "dart",
            "args": [
                "-d",
                "chrome",
                "--web-port=3000"
            ]
        }
    ]
}